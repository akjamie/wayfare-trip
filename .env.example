# Copy to .env and fill in real values. Never commit .env.

# Amap (高德) Web Service API key — required for attraction search + city geocoding.
# Apply at https://console.amap.com (Web Service API key).
AMAP_KEY=

# Optional threshold overrides (defaults shown)
WAYFARE_RAIN_PROB=50
WAYFARE_HIGH_TEMP_C=33
WAYFARE_NOON_START=11:00
WAYFARE_NOON_END=15:00

# Optional: forecast horizon (1-16) and per-day top-N
WAYFARE_FORECAST_DAYS=7
WAYFARE_TOP_N=10
